#!/bin/bash
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 022
if [ "${3:-/}" != / ]; then
  echo 'Install myEq on the current startup disk.' >&2
  exit 1
fi
if /usr/bin/pgrep -x myEq >/dev/null; then
  echo 'Quit myEq before installing or updating its audio components.' >&2
  exit 1
fi
script_dir=$(cd -- "$(dirname -- "$0")" && pwd -P)
"$script_dir/myEqMaintenance" prepare
