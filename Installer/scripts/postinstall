#!/bin/bash
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 022
if [ "${3:-/}" != / ]; then
  echo 'Install myEq on the current startup disk.' >&2
  exit 1
fi
script_dir=$(cd -- "$(dirname -- "$0")" && pwd -P)
# Validate all components, their trust relationships and filesystem objects before launch.
"$script_dir/myEqMaintenance" verify
/bin/launchctl bootstrap system /Library/LaunchDaemons/com.tc.myEq.bridge.plist
if /usr/bin/pgrep -x coreaudiod >/dev/null; then
  /usr/bin/killall -TERM coreaudiod
fi
echo 'myEq installed. Core Audio was reloaded; no Mac restart is required. Open /Applications/myEq.app and allow its background helper if prompted. Quit and reopen playback apps, including Music, to reconnect them to Core Audio.'
