#!/bin/bash
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 022
if [ "${3:-/}" != / ]; then
  echo 'Install myEq on the current startup disk.' >&2
  exit 1
fi
script_dir=$(cd -- "$(dirname -- "$0")" && pwd -P)
# Validate all components, their trust relationships and filesystem objects before launch.
"$script_dir/myEqMaintenance" verify
reload_policy=$("$script_dir/myEqMaintenance" audio-reload-policy)
case "$reload_policy" in reload|keep) ;; *) echo 'Invalid audio reload policy.' >&2; exit 1 ;; esac
/bin/launchctl bootstrap system /Library/LaunchDaemons/com.tc.myEq.bridge.plist
if [ "$reload_policy" = reload ]; then
  if /usr/bin/pgrep -x coreaudiod >/dev/null; then /usr/bin/killall -TERM coreaudiod; fi
  echo 'Core Audio was reloaded because its driver or bridge changed. Reopen playback apps to reconnect.'
else
  echo 'Audio driver and bridge are unchanged; Core Audio was not restarted.'
fi
echo 'myEq installed. Open /Applications/myEq.app and allow its background helper if prompted.'
